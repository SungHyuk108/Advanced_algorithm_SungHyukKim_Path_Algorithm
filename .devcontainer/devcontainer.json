{
  // GitHub Codespaces와 VS Code Dev Containers용 설정 (algorithm-env 템플릿에서 가져옴).
  //
  // 로컬에서 쓰는 compose.yml을 그대로 재사용한다. Codespaces에서 열든
  // 로컬에서 `docker compose up -d`로 띄우든 완전히 같은 컨테이너다.
  "name": "pathfinding-compare",
  "dockerComposeFile": "../compose.yml",
  "service": "lab",
  // compose.yml이 저장소 폴더를 /work에 마운트한다. 그 경로를 그대로 연다.
  "workspaceFolder": "/work",
  // compose.yml의 `sleep infinity`가 컨테이너를 띄워 둔다. 덮어쓰지 않는다.
  "overrideCommand": false,
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // 컨테이너가 준비되면 버전을 찍고 테스트를 한 번 돌린다.
  "postCreateCommand": "python --version && python -c \"import matplotlib; print('matplotlib', matplotlib.__version__)\" && python -m unittest"
}
